APP_NAME=SKD
APP_ENV=local
APP_KEY=
# Kunci blind index NIK (HMAC-SHA256), terpisah dari APP_KEY.
# WAJIB diisi eksplisit saat APP_ENV=production. Bila hilang atau berganti,
# pencarian/login NIK gagal sampai hash dihitung ulang (lihat README).
SATUDUKA_NIK_HASH_KEY=
# Produksi WAJIB false agar jejak tumpukan tidak tampil.
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# Terima NIK demo awalan 99 (hanya lokal; di produksi diabaikan kecuali
# SATUDUKA_IZINKAN_MOCK_DEMO=true untuk demo terkontrol).
VERIFIKASI_NIK_DEMO=true

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database lokal (SQLite) ---
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# Opsional; jangan arahkan ke database dev saat menjalankan Behat atau tes lain yang me-refresh database.
# DB_SQLITE_DATABASE=database/database.sqlite

# --- Opsi PostgreSQL (deploy) ---
# Isi hanya saat deploy. Kredensial asli jangan di-commit.
# DB_CONNECTION=pgsql
# DB_HOST=
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=
# DB_PASSWORD=
# DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Produksi: aktifkan cookie aman (HTTPS).
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Layanan analisis dokumen berbantuan AI ---
# Pilihan driver: mock | tesseract | deepseek | openai | gemini.
# `mock` DITOLAK di luar APP_ENV=local/testing (LogicException saat aplikasi
# memakai layanan AI), jadi produksi wajib memakai driver nyata. Driver yang
# tidak dikenal juga ditolak, bukan diam-diam jatuh ke mock.
# `tesseract` bekerja sepenuhnya lokal (OCR, tanpa jaringan);
# `deepseek` adalah model utama (API kompatibel OpenAI, teks saja).
AI_DRIVER=mock
AI_TIMEOUT=20
AI_CONNECT_TIMEOUT=30
AI_CACHE_TTL=3600
AI_RATE_LIMIT=10
AI_RATE_WINDOW=60

# Coba ulang saat penyedia membalas 429/503 (sibuk). Hasil yang tetap sibuk
# ditandai "tertunda" (bukan gagal) sehingga dapat dicoba lagi tanpa mengulang
# unggah. Anggaran total waktu tunggu dipangkas agar tetap di bawah AI_TIMEOUT
# dan batas eksekusi PHP 180 detik.
AI_RETRY_MAKS=2
AI_RETRY_JEDA_MS=800
AI_RETRY_ANGGARAN_DETIK=20
AI_BATAS_EKSEKUSI_PHP=180

# Kunci penyedia hanya diisi di .env, jangan di-commit.
# Driver `openai` (Responses API, dokumen dikirim sebagai berkas/gambar).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Driver `gemini` (generateContent, dokumen inline base64).
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash

# Driver `deepseek` (chat/completions, teks saja: dokumen diubah ke teks dulu).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OCR lokal (driver tesseract / pembacaan gambar). Isi jalur lengkap pada
# Windows, mis. TESSERACT_BINARY="C:\Program Files\Tesseract-OCR\tesseract.exe".
TESSERACT_BINARY=tesseract
TESSERACT_LANG=ind+eng
TESSERACT_TIMEOUT=30

# Fallback OCR PDF hasil pindaian yang tidak punya text-layer. `pdftoppm`
# berasal dari paket poppler-utils; batas halaman mencegah OCR berjalan terlalu
# lama pada dokumen tebal.
PDFTOPPM_BINARY=pdftoppm
AI_PDF_OCR_MAKS_HALAMAN=3
AI_PDF_OCR_TIMEOUT=60

# --- Tanda tangan elektronik (TTE) ---
# Driver mock hanya untuk lokal/pengujian; produksi wajib penyedia tersertifikasi.
SATUDUKA_TTE_DRIVER=mock
# PIN dummy hanya diisi pada lokal/pengujian; JANGAN diisi di produksi.
SATUDUKA_TTE_PIN_DUMMY=

# --- Batas laju rute sensitif ---
# true = batas dilonggarkan untuk demo/presentasi (bukan dihapus).
SATUDUKA_RATE_LIMIT_LONGGAR=false
