    <script>
        const form = document.getElementById('applicationForm');
        const panels = [...document.querySelectorAll('.step-panel')];
        const indicators = [...document.querySelectorAll('.step-item')];

        const stepsProgress = document.getElementById('stepsProgress');
        const backButton = document.getElementById('backButton');
        const nextButton = document.getElementById('nextButton');
        const draftButton = document.getElementById('draftButton');
        const submitButton = document.getElementById('submitButton');
        const notice = document.getElementById('notice');

        let currentStep = 0;

        const fieldsToSave = [
            'nama_pelapor',
            'nik_pelapor',
            'kontak_pelapor',
            'email_pelapor',
            'hubungan',
            'nama_almarhum',
            'nik_almarhum',
            'jenis_kelamin',
            'tanggal_kematian',
            'waktu_kematian',
            'jenis_tempat',
            'tempat_kematian',
            'sebab_kematian'
        ];

        function showNotice(message, type = '') {
            notice.textContent = message;
            notice.className = 'notice';

            if (type) {
                notice.classList.add(type);
            }

            notice.style.display = 'block';
            notice.scrollIntoView({
                behavior: 'smooth',
                block: 'center'
            });
        }

        function hideNotice() {
            notice.style.display = 'none';
            notice.textContent = '';
            notice.className = 'notice';
        }

        function valueOf(id) {
            const element = document.getElementById(id);
            return element ? element.value.trim() : '';
        }

        function fileNameOf(id) {
            const input = document.getElementById(id);
            const file = input.files && input.files[0];

            return file ? file.name : 'Belum dipilih';
        }

        function setReview(id, value) {
            const element = document.getElementById(id);

            if (element) {
                // textContent menjaga isi form sebagai teks, bukan HTML.
                element.textContent = value || '-';
            }
        }

        function updateReview() {
            setReview('review_nama_pelapor', valueOf('nama_pelapor'));
            setReview('review_nik_pelapor', valueOf('nik_pelapor'));
            setReview('review_kontak', valueOf('kontak_pelapor'));
            setReview('review_email', valueOf('email_pelapor'));
            setReview('review_hubungan', valueOf('hubungan'));

            setReview('review_nama_almarhum', valueOf('nama_almarhum'));
            setReview('review_nik_almarhum', valueOf('nik_almarhum'));
            setReview('review_jenis_kelamin', valueOf('jenis_kelamin'));
            setReview('review_tanggal', valueOf('tanggal_kematian'));
            setReview('review_waktu', valueOf('waktu_kematian'));
            setReview('review_jenis_tempat', valueOf('jenis_tempat'));
            setReview('review_tempat', valueOf('tempat_kematian'));
            setReview('review_sebab', valueOf('sebab_kematian'));

            setReview('review_surat', fileNameOf('surat_kematian'));
            setReview('review_ktp_almarhum', fileNameOf('ktp_almarhum'));
            setReview('review_ktp_pelapor', fileNameOf('ktp_pelapor'));
            setReview('review_kk', fileNameOf('kartu_keluarga'));
        }

        function showStep(index) {
            currentStep = index;

            panels.forEach((panel, i) => {
                panel.hidden = i !== index;
            });

            indicators.forEach((indicator, i) => {
                indicator.classList.toggle('active', i === index);
                indicator.classList.toggle('completed', i < index);

                const number = indicator.querySelector('.step-number');

                if (number) {
                    number.textContent = i < index ? 'Γ£ô' : String(i + 1);
                }
            });

            const progressPercentage =
                (index / (panels.length - 1)) * 100;

            stepsProgress.style.width = `${progressPercentage}%`;

            backButton.disabled = index === 0;
            nextButton.hidden = index === panels.length - 1;
            submitButton.hidden = index !== panels.length - 1;

            hideNotice();

            if (index === panels.length - 1) {
                updateReview();
            }

            window.scrollTo({
                top: 0,
                behavior: 'smooth'
            });
        }

        function validateFile(input) {
            if (!input.files || input.files.length === 0) {
                input.setCustomValidity(
                    input.required ? 'Silakan pilih dokumen ini.' : ''
                );

                return input.checkValidity();
            }

            const file = input.files[0];
            const allowedExtension = /\.(pdf|jpe?g|png)$/i.test(file.name);
            const maxSize = 2 * 1024 * 1024;

            if (!allowedExtension) {
                input.setCustomValidity(
                    'Format harus PDF, JPG, JPEG, atau PNG.'
                );
            } else if (file.size > maxSize) {
                input.setCustomValidity(
                    'Ukuran berkas maksimal 2 MB.'
                );
            } else {
                input.setCustomValidity('');
            }

            return input.checkValidity();
        }

        function validateCurrentStep() {
            const fields = [
                ...panels[currentStep].querySelectorAll(
                    'input, select, textarea'
                )
            ];

            for (const field of fields) {
                if (field.type === 'file') {
                    if (!validateFile(field)) {
                        field.reportValidity();
                        field.focus();
                        return false;
                    }
                } else {
                    field.setCustomValidity('');

                    if (!field.checkValidity()) {
                        field.reportValidity();
                        field.focus();
                        return false;
                    }
                }
            }

            return true;
        }

        document.querySelectorAll('input[type="file"]').forEach(input => {
            input.addEventListener('change', () => {
                input.setCustomValidity('');
                updateReview();
                hideNotice();
            });
        });

        nextButton.addEventListener('click', () => {
            if (!validateCurrentStep()) {
                return;
            }

            showStep(Math.min(currentStep + 1, panels.length - 1));
        });

        backButton.addEventListener('click', () => {
            showStep(Math.max(currentStep - 1, 0));
        });

        function collectDraft() {
            const draft = {};

            fieldsToSave.forEach(id => {
                draft[id] = valueOf(id);
            });

            draft.currentStep = currentStep;

            return draft;
        }

        function restoreDraft() {
            try {
                const saved = localStorage.getItem('satuduka_draft');

                if (!saved) {
                    return;
                }

                const draft = JSON.parse(saved);

                fieldsToSave.forEach(id => {
                    const input = document.getElementById(id);

                    if (input && typeof draft[id] === 'string') {
                        input.value = draft[id];
                    }
                });

                updateReview();

                showNotice(
                    'Draf lokal sebelumnya berhasil dimuat. Pilih kembali berkas pendukung apabila ingin melanjutkan pengajuan.',
                    'success'
                );
            } catch (error) {
                console.error('Draf tidak dapat dimuat:', error);
            }
        }

        draftButton.addEventListener('click', () => {
            try {
                localStorage.setItem(
                    'satuduka_draft',
                    JSON.stringify(collectDraft())
                );

                showNotice(
                    'Draf tersimpan di browser pada perangkat ini. Draf belum disimpan ke server atau Supabase. Berkas yang dipilih perlu dipilih ulang ketika melanjutkan.',
                    'success'
                );
            } catch (error) {
                showNotice(
                    'Draf tidak dapat disimpan pada browser ini. Coba lagi.',
                    'error'
                );
            }
        });

        submitButton.addEventListener('click', () => {
            if (!validateCurrentStep()) {
                return;
            }

            /*
             * Backend pengiriman belum diimplementasikan.
             * Belum ada request ke Laravel atau Supabase.
             */
            showNotice(
                'Validasi di browser berhasil. Pengajuan belum dikirim. Langkah berikutnya adalah membuat endpoint Laravel, validasi server, penyimpanan berkas, dan koneksi database Supabase.',
                ''
            );
        });

        restoreDraft();
        showStep(0);
    </script>
