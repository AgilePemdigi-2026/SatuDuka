
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Form Pengajuan Laporan Kematian | SatuDuka</title>

    <style>
        :root {
            --navy: #173b57;
            --navy-dark: #102e46;
            --blue: #246486;
            --blue-light: #e8f1fa;
            --page: #f1f5fb;
            --border: #dce5ef;
            --muted: #708198;
            --text: #26364a;
            --white: #ffffff;
            --success: #237653;
            --danger: #c44343;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: Arial, Helvetica, sans-serif;
            color: var(--text);
            background: var(--page);
            font-size: 14px;
        }

        button,
        input,
        select,
        textarea {
            font: inherit;
        }

        button {
            cursor: pointer;
        }

        button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        /* NAVBAR */

        .navbar {
            min-height: 66px;
            background: var(--white);
            border-bottom: 1px solid #e5ebf2;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 6%;
            gap: 20px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 11px;
            color: var(--navy);
            font-size: 19px;
            font-weight: 800;
        }

        .brand-mark {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            background: var(--navy);
            color: white;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 17px;
        }

        .brand small {
            display: block;
            margin-top: 3px;
            font-size: 10px;
            color: var(--muted);
            font-weight: 400;
        }

        .navbar-info {
            display: flex;
            align-items: center;
            gap: 9px;
            background: #f4f7fb;
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 8px 12px;
            color: #586a80;
            font-size: 12px;
        }

        .status-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #42866c;
        }

        /* PAGE */

        .container {
            width: min(1120px, calc(100% - 40px));
            margin: 34px auto 48px;
        }

        .page-heading {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 22px;
        }

        .page-heading h1 {
            color: var(--navy);
            font-size: clamp(23px, 3vw, 30px);
            letter-spacing: -0.6px;
            margin: 0 0 9px;
        }

        .page-heading p {
            color: var(--muted);
            line-height: 1.7;
            margin: 0;
            max-width: 700px;
        }

        .secure-label {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-shrink: 0;
            padding: 9px 12px;
            border: 1px solid #dbe5ef;
            border-radius: 8px;
            color: var(--navy);
            background: white;
            font-size: 11px;
        }

        /* MAIN CARD */

        .form-card {
            background: var(--white);
            border: 1px solid #e0e7f0;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 8px 28px rgba(32, 57, 84, 0.06);
        }

        .card-content {
            padding: 30px 36px;
        }

        /* FOUR-STEP PROGRESS */

        .steps {
            position: relative;
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            margin: 0 0 34px;
            padding: 0;
        }

        .steps-track {
            position: absolute;
            top: 17px;
            left: 12.5%;
            width: 75%;
            height: 3px;
            background: #dce5ef;
            border-radius: 5px;
            z-index: 0;
        }

        .steps-progress {
            height: 100%;
            width: 0;
            background: var(--navy);
            border-radius: 5px;
            transition: width 0.25s ease;
        }

        .step-item {
            min-width: 0;
            position: relative;
            z-index: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            gap: 9px;
            color: #8290a3;
            font-size: 12px;
            line-height: 1.45;
        }

        .step-number {
            width: 36px;
            height: 36px;
            flex-shrink: 0;
            border: 2px solid #dce5ef;
            border-radius: 50%;
            background: #edf2f8;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #76869a;
            font-size: 13px;
            font-weight: 700;
            transition: background 0.25s ease, color 0.25s ease;
        }

        .step-item.active {
            color: var(--navy);
            font-weight: 700;
        }

        .step-item.active .step-number,
        .step-item.completed .step-number {
            background: var(--navy);
            border-color: var(--navy);
            color: white;
        }

        .step-item.completed {
            color: var(--navy);
        }

        /* INFORMATION BANNER */

        .info-banner {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 15px 16px;
            background: #edf4fc;
            border: 1px solid #dce8f6;
            border-radius: 9px;
            margin-bottom: 26px;
            color: #3c5874;
            line-height: 1.65;
            font-size: 12px;
        }

        .info-icon {
            width: 23px;
            height: 23px;
            flex-shrink: 0;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--navy);
            color: white;
            font-weight: 700;
        }

        .info-banner strong {
            display: block;
            color: var(--navy);
            margin-bottom: 3px;
        }

        /* FORM HEADINGS */

        .section-heading {
            margin-bottom: 24px;
        }

        .section-heading h2 {
            margin: 0 0 8px;
            color: #20364d;
            font-size: 20px;
            letter-spacing: -0.2px;
        }

        .section-heading p {
            color: var(--muted);
            line-height: 1.65;
            margin: 0;
            font-size: 13px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            column-gap: 24px;
            row-gap: 0;
        }

        .field {
            min-width: 0;
            margin-bottom: 21px;
        }

        .field.full {
            grid-column: 1 / -1;
        }

        .label-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            margin-bottom: 8px;
        }

        label {
            color: #2b3d52;
            font-size: 12px;
            font-weight: 700;
            line-height: 1.5;
        }

        .required {
            color: var(--danger);
        }

        .optional {
            color: #8997a8;
            font-size: 10px;
            font-weight: 400;
        }

        .input-wrap {
            position: relative;
        }

        input:not([type="checkbox"]):not([type="file"]),
        select,
        textarea {
            width: 100%;
            min-height: 44px;
            border: 1px solid #d6e0eb;
            border-radius: 7px;
            outline: none;
            padding: 11px 13px;
            background: white;
            color: var(--text);
            font-size: 13px;
            transition: border-color 0.18s ease, box-shadow 0.18s ease;
        }

        textarea {
            min-height: 100px;
            resize: vertical;
            line-height: 1.6;
        }

        input:focus,
        select:focus,
        textarea:focus {
            border-color: #517c9e;
            box-shadow: 0 0 0 3px rgba(44, 100, 137, 0.10);
        }

        input::placeholder,
        textarea::placeholder {
            color: #9aa6b5;
        }

        input[aria-invalid="true"],
        select[aria-invalid="true"],
        textarea[aria-invalid="true"] {
            border-color: var(--danger);
        }

        .helper {
            color: #8290a2;
            margin: 7px 0 0;
            line-height: 1.5;
            font-size: 11px;
        }

        /* UPLOAD DOCUMENTS */

        .upload-list {
            display: grid;
            gap: 13px;
        }

        .upload-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 18px;
            padding: 17px;
            border: 1px solid #dce5ef;
            border-radius: 9px;
            background: #fff;
        }

        .upload-meta {
            display: flex;
            align-items: center;
            gap: 13px;
            min-width: 0;
        }

        .upload-icon {
            width: 42px;
            height: 42px;
            flex-shrink: 0;
            border-radius: 9px;
            display: flex;
            justify-content: center;
            align-items: center;
            background: #eaf2fb;
            color: var(--navy);
            font-size: 12px;
            font-weight: 800;
        }

        .upload-name {
            font-weight: 700;
            color: #30445a;
            line-height: 1.5;
            font-size: 12px;
        }

        .upload-desc {
            color: #8b98a8;
            font-size: 11px;
            margin-top: 4px;
            line-height: 1.5;
        }

        .file-picker {
            flex-shrink: 0;
            max-width: 48%;
            width: 280px;
            color: #64748b;
            font-size: 11px;
        }

        input[type="file"] {
            display: block;
            max-width: 100%;
            width: 100%;
            padding: 8px;
            border: 1px solid #dce5ef;
            border-radius: 7px;
            background: #f8fafc;
            color: #64748b;
            font-size: 11px;
        }

        /* REVIEW */

        .review-section {
            margin-bottom: 19px;
            padding: 20px;
            background: #fbfcfe;
            border: 1px solid #dfe8f2;
            border-radius: 10px;
        }

        .review-title {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 0 0 16px;
            color: var(--navy);
            font-size: 14px;
        }

        .review-icon {
            display: flex;
            width: 26px;
            height: 26px;
            align-items: center;
            justify-content: center;
            border-radius: 7px;
            color: white;
            background: var(--navy);
            font-size: 12px;
        }

        .review-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 18px;
        }

        .review-label {
            color: #8390a0;
            font-size: 11px;
            margin-bottom: 6px;
        }

        .review-value {
            color: #2c4057;
            font-size: 12px;
            font-weight: 600;
            line-height: 1.6;
            overflow-wrap: anywhere;
        }

        .review-file {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 11px 0;
            border-bottom: 1px solid #e9eef5;
        }

        .review-file:last-child {
            border-bottom: 0;
            padding-bottom: 0;
        }

        .file-badge {
            width: 28px;
            height: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            border-radius: 6px;
            background: #eaf2fb;
            color: var(--navy);
            font-size: 10px;
            font-weight: 800;
        }

        .review-file-name {
            flex: 1;
            color: #40546b;
            font-size: 12px;
            line-height: 1.5;
            overflow-wrap: anywhere;
        }

        .file-status {
            color: #8290a2;
            font-size: 11px;
            text-align: right;
        }

        .agreement {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: 16px;
            margin-top: 20px;
            border: 1px solid #dce5ef;
            border-radius: 9px;
            background: #f8fafc;
            line-height: 1.7;
            font-size: 12px;
            color: #52657a;
        }

        .agreement input {
            margin-top: 3px;
            accent-color: var(--navy);
            flex-shrink: 0;
        }

        /* NOTICE AND FOOTER */

        .notice {
            display: none;
            padding: 13px 15px;
            margin-bottom: 20px;
            border-radius: 8px;
            border: 1px solid #d8e5f1;
            background: #edf4fc;
            color: var(--navy);
            line-height: 1.65;
            font-size: 12px;
        }

        .notice.error {
            border-color: #f1caca;
            background: #fff2f2;
            color: #9c3030;
        }

        .notice.success {
            border-color: #c9e6d6;
            background: #effaf3;
            color: var(--success);
        }

        .actions {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            margin-top: 26px;
            padding-top: 22px;
            border-top: 1px solid #e5ebf2;
        }

        .action-right {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            flex-wrap: wrap;
            gap: 10px;
        }

        .btn {
            min-height: 42px;
            padding: 11px 17px;
            border: 1px solid transparent;
            border-radius: 7px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            font-size: 12px;
            font-weight: 700;
            transition: background 0.18s ease;
        }

        .btn-primary {
            background: var(--navy);
            color: white;
        }

        .btn-primary:hover:not(:disabled) {
            background: var(--navy-dark);
        }

        .btn-secondary {
            background: white;
            color: #53677e;
            border-color: #d8e2ed;
        }

        .btn-secondary:hover:not(:disabled) {
            background: #f3f6fa;
        }

        .btn-outline {
            background: white;
            color: var(--navy);
            border-color: #9fb5c9;
        }

        .btn-outline:hover:not(:disabled) {
            background: #f0f5fa;
        }

        .footer {
            text-align: center;
            color: #8794a5;
            font-size: 11px;
            line-height: 1.7;
            padding: 22px 12px;
        }

        .footer strong {
            color: var(--navy);
        }

        [hidden] {
            display: none !important;
        }

        /* RESPONSIVE */

        @media (max-width: 700px) {
            .navbar {
                padding: 12px 18px;
                min-height: 62px;
            }

            .navbar-info {
                display: none;
            }

            .container {
                width: calc(100% - 24px);
                margin: 23px auto 30px;
            }

            .page-heading {
                display: block;
            }

            .secure-label {
                display: inline-flex;
                margin-top: 13px;
            }

            .card-content {
                padding: 22px 17px;
            }

            .steps {
                margin-bottom: 25px;
                gap: 2px;
            }

            .step-item {
                font-size: 10px;
            }

            .step-number {
                width: 32px;
                height: 32px;
            }

            .steps-track {
                top: 15px;
            }

            .form-grid {
                grid-template-columns: 1fr;
            }

            .field.full {
                grid-column: auto;
            }

            .upload-row {
                align-items: flex-start;
                flex-direction: column;
                gap: 13px;
            }

            .file-picker {
                max-width: 100%;
                width: 100%;
            }

            .review-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .actions {
                align-items: stretch;
                flex-direction: column-reverse;
            }

            .action-right {
                justify-content: stretch;
                width: 100%;
            }

            .action-right .btn {
                flex: 1;
            }

            .actions > .btn {
                width: 100%;
            }
        }

        @media (max-width: 380px) {
            .review-grid {
                grid-template-columns: 1fr;
            }

            .step-item {
                font-size: 9px;
            }

            .card-content {
                padding: 19px 13px;
            }
        }
    </style>
</head>

<body>
    <header class="navbar">
        <div class="brand">
            <div class="brand-mark">S</div>
            <div>
                SATUDUKA
                <small>Sistem Administrasi Terpadu Urusan Duka</small>
            </div>
        </div>

        <div class="navbar-info">
            <span class="status-dot"></span>
            Layanan Pengajuan Laporan
        </div>
    </header>

    <main class="container">
        <div class="page-heading">
            <div>
                <h1>Form Pengajuan Laporan Kematian</h1>
                <p>
                    Lengkapi informasi pelapor, data almarhum/almarhumah,
                    serta dokumen pendukung untuk melanjutkan pengajuan.
                </p>
            </div>

            <div class="secure-label">
                <span>ΓùÅ</span>
                Layanan SatuDuka
            </div>
        </div>

        <div class="form-card">
            <div class="card-content">

                <!-- STEPPER -->
                <div class="steps" aria-label="Tahapan pengajuan">
                    <div class="steps-track">
                        <div class="steps-progress" id="stepsProgress"></div>
                    </div>

                    <div class="step-item active">
                        <div class="step-number">1</div>
                        <span>Data Pelapor</span>
                    </div>

                    <div class="step-item">
                        <div class="step-number">2</div>
                        <span>Data Almarhum</span>
                    </div>

                    <div class="step-item">
                        <div class="step-number">3</div>
                        <span>Unggah Berkas</span>
                    </div>

                    <div class="step-item">
                        <div class="step-number">4</div>
                        <span>Review Pengajuan</span>
                    </div>
                </div>

                <!-- NOTICE -->
                <div class="notice" id="notice" role="status" aria-live="polite"></div>

                <form id="applicationForm" novalidate>
                    <!-- LANGKAH 1 -->
                    <section class="step-panel">
                        <div class="info-banner">
                            <div class="info-icon">i</div>
                            <div>
                                <strong>Informasi Pengajuan</strong>
                                Pastikan data pelapor sesuai dengan identitas
                                resmi dan gunakan kontak yang masih aktif.
                            </div>
                        </div>

                        <div class="section-heading">
                            <h2>Data Pelapor</h2>
                            <p>
                                Masukkan identitas dan informasi kontak orang
                                yang mengajukan laporan kematian.
                            </p>
                        </div>

                        <div class="form-grid">
                            <div class="field">
                                <div class="label-row">
                                    <label for="nama_pelapor">
                                        Nama Lengkap Pelapor
                                        <span class="required">*</span>
                                    </label>
                                </div>
                                <input
                                    id="nama_pelapor"
                                    name="nama_pelapor"
                                    type="text"
                                    required
                                    maxlength="150"
                                    autocomplete="name"
                                    placeholder="Masukkan nama sesuai identitas"
                                >
                            </div>

                            <div class="field">
                                <div class="label-row">
                                    <label for="nik_pelapor">
                                        NIK Pelapor
                                        <span class="required">*</span>
                                    </label>
                                </div>
                                <input
                                    id="nik_pelapor"
                                    name="nik_pelapor"
                                    type="text"
                                    inputmode="numeric"
                                    pattern="[0-9]{16}"
                                    minlength="16"
                                    maxlength="16"
                                    required
                                    placeholder="Masukkan 16 digit NIK"
                                >
                                <p class="helper">NIK terdiri dari 16 digit angka.</p>
                            </div>

                            <div class="field">
                                <div class="label-row">
                                    <label for="kontak_pelapor">
                                        Nomor Telepon / WhatsApp
                                        <span class="required">*</span>
                                    </label>
                                </div>
                                <input
                                    id="kontak_pelapor"
                                    name="kontak_pelapor"
                                    type="tel"
                                    required
                                    maxlength="20"
                                    autocomplete="tel"
                                    placeholder="Contoh: 08xxxxxxxxxx"
                                >
                            </div>

                            <div class="field">
                                <div class="label-row">
                                    <label for="email_pelapor">
                                        Alamat Email
                                        <span class="required">*</span>
                                    </label>
                                </div>
                                <input
                                    id="email_pelapor"
                                    name="email_pelapor"
                                    type="email"
                                    required
                                    maxlength="150"
                                    autocomplete="email"
                                    placeholder="nama@email.com"
                                >
                            </div>

                            <div class="field full">
                                <div class="label-row">
                                    <label for="hubungan">
                                        Hubungan dengan Almarhum/Almarhumah
                                        <span class="required">*</span>
                                    </label>
                                </div>
                                <select id="hubungan" name="hubungan" required>
                                    <option value="">Pilih hubungan keluarga</option>
                                    <option value="Anak">Anak</option>
                                    <option value="Suami/Istri">Suami/Istri</option>
                                    <option value="Orang Tua">Orang Tua</option>
                                    <option value="Saudara">Saudara</option>
                                    <option value="Cucu">Cucu</option>
                                    <option value="Keluarga Lain">Keluarga Lain</option>
                                    <option value="Lainnya">Lainnya</option>
                                </select>
                            </div>
                        </div>
                    </section>

                    <!-- LANGKAH 2 -->
                    <section class="step-panel" hidden>
                        <div class="info-banner">
                            <div class="info-icon">i</div>
                            <div>
                                <strong>Data Almarhum/Almarhumah</strong>
                                Isi sesuai dokumen kependudukan dan informasi
                                peristiwa kematian yang dimiliki.
                            </div>
                        </div>

                        <div class="section-heading">
                            <h2>Data Almarhum/Almarhumah</h2>
                            <p>
                                Lengkapi identitas dan informasi kejadian
                                kematian sebelum melanjutkan.
                            </p>
                        </div>

                        <div class="form-grid">
                            <div class="field">
                                <div class="label-row">
                                    <label for="nama_almarhum">
                                        Nama Lengkap
                                        <span class="required">*</span>
                                    </label>
                                </div>
                                <input
                                    id="nama_almarhum"
                                    name="nama_almarhum"
                                    type="text"
                                    required
                                    maxlength="150"
                                    placeholder="Nama sesuai identitas"
                                >
                            </div>

                            <div class="field">
                                <div class="label-row">
                                    <label for="nik_almarhum">
                                        NIK Almarhum/Almarhumah
                                        <span class="required">*</span>
                                    </label>
                                </div>
                                <input
                                    id="nik_almarhum"
                                    name="nik_almarhum"
                                    type="text"
                                    inputmode="numeric"
                                    pattern="[0-9]{16}"
                                    minlength="16"
                                    maxlength="16"
                                    required
                                    placeholder="Masukkan 16 digit NIK"
                                >
                                <p class="helper">NIK terdiri dari 16 digit angka.</p>
                            </div>

